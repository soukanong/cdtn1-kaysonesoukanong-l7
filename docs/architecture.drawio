        <mxCell id="c2" parent="1" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=14;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Hình 3.1 – Kiến trúc phân lớp 4 lớp của hệ thống L7&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="920" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=5;fillColor=#E8F0F8;strokeColor=#2A6A9E;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=8;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;1 · LỚP TRÌNH BÀY (Presentation)&lt;/b&gt;&lt;br&gt;&lt;br&gt;[CLI: make run] [Khung 1: Tổng quan độ sạch] [Khung 2: Xu hướng] [Khung 3: Nghi trùng và gộp hồ sơ, gồm form tạo hồ sơ mới]&lt;br&gt;&lt;br&gt;&lt;i style=&quot;&quot;&gt;Nhận thao tác người dùng, hiển thị kết quả (Streamlit). Không chứa quy tắc, không truy vấn dữ liệu trực tiếp.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="920" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=5;fillColor=#FDF0DC;strokeColor=#C0680A;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=8;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;2 · LỚP NGHIỆP VỤ (Service)&lt;/b&gt;&lt;br&gt;&lt;br&gt;PipelineService – chuẩn hóa số điện thoại và họ tên, đối chiếu trùng, tìm nghi trùng, đo RAW/CLEAN&lt;br&gt;DuplicateReviewService – xác nhận gộp · CustomerIntakeService – kiểm tra hồ sơ mới · ReportService – báo cáo và xu hướng&lt;br&gt;&lt;br&gt;&lt;i&gt;TOÀN BỘ quy tắc QT-01, QT-02, QT-13, BR-L7-01 đến BR-L7-05 nằm trong lớp này.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="920" x="40" y="240" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=5;fillColor=#E2F3EA;strokeColor=#14905F;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=8;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;3 · LỚP TRUY CẬP DỮ LIỆU (Repository)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SourceRepository (customers_raw.csv, stores.csv) · CustomerRepository · DuplicateReviewRepository · DwhRepository&lt;br&gt;&lt;br&gt;&lt;i&gt;Đọc/ghi dữ liệu, che giấu SQLAlchemy và PostgreSQL. Không chứa quy tắc nghiệp vụ.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="920" x="40" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=5;fillColor=#F1F2F4;strokeColor=#2B3A4B;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=8;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;4 · LỚP LƯU TRỮ (Data store – PostgreSQL 16)&lt;/b&gt;&lt;br&gt;&lt;br&gt;customers_raw.csv · stores.csv (chỉ đọc)&lt;br&gt;stg: stg_customer · core: customer_clean, reject_customer, duplicate_review, merge_log&lt;br&gt;dwh: dim_date, dim_run, dim_dq_rule, dim_store, fact_dq_result, fact_dq_issue · view: view_customer_masked&lt;br&gt;&lt;br&gt;&lt;i&gt;Giữ dữ liệu, bảo đảm toàn vẹn: khóa chính, khóa ngoại, UNIQUE. view_customer_masked che số điện thoại và lọc theo store_key. Tên bảng khớp Mục 4.&lt;/i&gt;&lt;/font&gt;" vertex="1">
