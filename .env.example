# Sao chép thành .env rồi sửa giá trị. KHÔNG commit .env thật.
# Chuỗi kết nối kho dữ liệu PostgreSQL (khớp với docker-compose.yml)
DWH_URL=postgresql+psycopg://l7_user:change_me@localhost:5432/l7_dq

# Tệp nguồn. Bỏ trống: dùng data/customers_raw.csv nếu có, nếu không dùng data/mau/customers_raw_sample.csv
SOURCE_CSV=

# Tệp ngưỡng chất lượng và thư mục báo cáo
THRESHOLDS_FILE=configs/thresholds.yaml
REPORT_DIR=reports
LOG_LEVEL=INFO

# Biến cho docker-compose (dịch vụ PostgreSQL)
POSTGRES_USER=l7_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=l7_dq
